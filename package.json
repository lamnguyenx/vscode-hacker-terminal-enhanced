{
	"name": "hacker-terminal-enhanced",
	"displayName": "Hacker Terminal Enhanced",
	"description": "Browse and copy recent terminal commands and their output in an LLM-friendly format.",
	"version": "2026.9.9",
	"publisher": "lamnguyenx",
	"author": "lamnguyenx <lamfm95@gmail.com>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/lamnguyenx/vscode-hacker-terminal-enhanced.git"
	},
	"icon": "media/icon.png",
	"engines": {
		"vscode": "^1.100.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onStartupFinished",
		"onView:terminalEnhanced.historyView",
		"onCommand:terminalEnhanced.showHistory"
	],
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "terminalEnhanced.showHistory",
				"title": "Show Command History",
				"category": "Hacker Terminal Enhanced"
			},
			{
				"command": "terminalEnhanced.clearHistory",
				"title": "Clear Command History",
				"category": "Hacker Terminal Enhanced"
			},
			{
				"command": "terminalEnhanced.hideHistory",
				"title": "Hide Command History",
				"category": "Hacker Terminal Enhanced"
			}
		],
		"keybindings": [
			{
				"command": "terminalEnhanced.showHistory",
				"key": "ctrl+cmd+shift+c",
				"mac": "ctrl+cmd+shift+c",
				"linux": "ctrl+alt+shift+c",
				"win": "ctrl+alt+shift+c",
				"when": "terminalFocus"
			}
		],
		"configuration": {
			"title": "Hacker Terminal Enhanced",
			"properties": {
				"terminalEnhanced.historyDisplay": {
					"type": "string",
					"enum": [
						"editor",
						"panel",
						"sidebar",
						"secondarySidebar",
						"window"
					],
					"default": "editor",
					"enumDescriptions": [
						"An editor tab (persistent).",
						"The bottom panel, next to the terminal.",
						"The primary sidebar (Activity Bar).",
						"The secondary sidebar.",
						"A separate OS window."
					],
					"description": "Where the command history is shown."
				},
				"terminalEnhanced.closeOnCopy": {
					"type": "boolean",
					"default": false,
					"description": "Close the history view or panel immediately after a command is copied."
				},
				"terminalEnhanced.historySize": {
					"type": "number",
					"default": 10,
					"minimum": 1,
					"description": "How many recent commands to keep in the history popup."
				},
				"terminalEnhanced.maxOutputLength": {
					"type": "number",
					"default": 1000000,
					"minimum": 1000,
					"description": "Maximum number of characters of a command's output to capture (per command)."
				}
			}
		},
		"viewsContainers": {
			"panel": [
				{
					"id": "terminalEnhanced-panel",
					"title": "Hacker Terminal Enhanced",
					"icon": "media/history.svg"
				}
			],
			"activitybar": [
				{
					"id": "terminalEnhanced-sidebar",
					"title": "Hacker Terminal Enhanced",
					"icon": "media/history.svg"
				}
			],
			"secondarySidebar": [
				{
					"id": "terminalEnhanced-auxiliary",
					"title": "Hacker Terminal Enhanced",
					"icon": "media/history.svg"
				}
			]
		},
		"views": {
			"terminalEnhanced-panel": [
				{
					"type": "webview",
					"id": "terminalEnhanced.historyView",
					"name": "History",
					"icon": "media/history.svg",
					"contextualTitle": "Hacker Terminal History",
					"when": "terminalEnhanced.display == 'panel' || terminalEnhanced.display == 'sidebar' || terminalEnhanced.display == 'secondarySidebar'"
				}
			]
		},
		"menus": {
			"commandPalette": [
				{
					"command": "terminalEnhanced.hideHistory",
					"when": "false"
				}
			]
		}
	},
	"scripts": {
		"build:webview": "bun build src/webview/popup.ts --outfile media/popup.js --target browser --format iife",
		"build:webview:watch": "bun build src/webview/popup.ts --outfile media/popup.js --target browser --format iife --watch",
		"dev:webview": "bun scripts/dev-webview.ts",
		"compile": "tsc -p ./ && npm run build:webview",
		"watch": "tsc -w -p ./",
		"typecheck:webview": "tsc -p tsconfig.webview.json",
		"typecheck:tests": "tsc -p tsconfig.tests.json",
		"test:units": "bun tests/units/history_check.ts && bun tests/units/store_check.ts",
		"test:e2e": "playwright test --config playwright.config.ts",
		"vscode:prepublish": "npm run compile",
		"package": "vsce package"
	},
	"devDependencies": {
		"@playwright/test": "^1.63.0",
		"@types/node": "^26.0.0",
		"@types/vscode": "^1.100.0",
		"@vscode/vsce": "^3.9.2",
		"typescript": "^5.5.0"
	}
}
