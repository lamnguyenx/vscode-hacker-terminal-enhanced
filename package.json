{
	"name": "hacker-terminal-enhanced",
	"displayName": "Hacker Terminal Enhanced",
	"description": "Copy the last command and its output from the active terminal in an LLM-friendly format.",
	"version": "2026.9.3",
	"publisher": "lamnguyenx",
	"author": "lamnguyenx <lamfm95@gmail.com>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/lamnguyenx/vscode-hacker-terminal-enhanced.git"
	},
	"icon": "media/icon.png",
	"engines": {
		"vscode": "^1.100.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onStartupFinished",
		"onCommand:terminalEnhanced.copyLast"
	],
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "terminalEnhanced.copyLast",
				"title": "Copy Last Command and Output",
				"category": "Hacker Terminal Enhanced"
			}
		],
		"keybindings": [
			{
				"command": "terminalEnhanced.copyLast",
				"key": "ctrl+cmd+shift+c",
				"mac": "ctrl+cmd+shift+c",
				"linux": "ctrl+alt+shift+c",
				"win": "ctrl+alt+shift+c",
				"when": "terminalFocus"
			}
		]
	},
	"scripts": {
		"compile": "tsc -p ./",
		"watch": "tsc -w -p ./",
		"typecheck:tests": "tsc -p tsconfig.tests.json",
		"test:e2e": "playwright test --config playwright.config.ts",
		"vscode:prepublish": "npm run compile",
		"package": "vsce package"
	},
	"devDependencies": {
		"@playwright/test": "^1.63.0",
		"@types/node": "^26.0.0",
		"@types/vscode": "^1.100.0",
		"@vscode/vsce": "^3.9.2",
		"typescript": "^5.5.0"
	}
}
